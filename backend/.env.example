# --- Server ---
# HTTP listen port. Default 3000.
PORT=3000

# --- 2API reverse proxy (OpenAI Images API compatible) ---
# Origin of the 2API gateway (no trailing slash, no /v1 suffix — the provider appends /v1/...).
IMAGE_API_BASE_URL=https://api.2api.example
# Server-side only. NEVER expose to the frontend. Required.
IMAGE_API_KEY=replace-me
# Inbound API key for OpenAI-compatible /v1 clients. Required.
OPENAI_COMPAT_API_KEY=replace-me-openai-compat
# Default model used by TwoApiImageProvider.
IMAGE_MODEL=gpt-image-2
# Per-request timeout in milliseconds. Default 120000 (2 min).
IMAGE_API_TIMEOUT_MS=120000
# Runtime GPT account pool quota exposed to the frontend. Default 100.
GPT_POOL_QUOTA=100

# --- Local filesystem storage ---
# Where uploaded reference images land. Relative to backend/.
UPLOAD_DIR=./tmp/uploads
# Maximum upload size in bytes. Default 10485760 (10 MiB). multer limits.fileSize
# uses this; oversized requests fail with 413 PAYLOAD_TOO_LARGE.
UPLOAD_MAX_BYTES=10485760
# Where generated images land. Relative to backend/.
OUTPUT_DIR=./tmp/outputs

# --- Logger ---
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- CORS ---
# Allowed origin for browser clients. Vite dev defaults to 5173.
CORS_ORIGIN=http://localhost:5173

# --- Better Auth ---
# Base URL of this backend; used to build OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:3000
# Secret for signing session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# Local/demo only: set true to auto-create admin / admin123 on startup.
# Keep false in production; the default weak credential is never seeded unless this is true.
SEED_DEFAULT_ADMIN=false

# --- Google OAuth (optional) ---
# OPTIONAL for MVP: username/password sign-in is the primary login surface.
# To enable Google sign-in: configure in Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth 2.0 Client, set the redirect URI to
# ${BETTER_AUTH_URL}/api/auth/callback/google, and fill both values below.
# Leave BOTH unset to soft-hide the Google provider (the backend will still boot).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend origin (CORS for cookie-authenticated requests) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- SQLite ---
# Persistent path for the SQLite file used by Better Auth + user_quota.
# Directory is created on boot if missing. WAL mode is enabled automatically.
SQLITE_PATH=./data/app.sqlite

# --- Per-user daily quota ---
# Each user's used_today counter resets at the start of a new server-local day.
# Generation attempts beyond this limit fail with 429 QUOTA_EXHAUSTED.
DAILY_USER_QUOTA=20
