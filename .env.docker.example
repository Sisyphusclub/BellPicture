# Docker Compose environment template.
# Copy this file to .env at the repository root before running docker compose.
# Do not commit the real .env file.

# --- Required provider settings ---
# Use the provider's internal Docker URL in production when possible to avoid
# public proxy timeout limits. Example: http://chatgpt2api
IMAGE_API_BASE_URL=https://api.2api.example
# Optional: route admin-only 2K/4K calls through a dedicated provider/Codex origin.
# Leave empty to reuse IMAGE_API_BASE_URL.
HIGH_RES_IMAGE_API_BASE_URL=
IMAGE_API_KEY=replace-me
# Optional: dedicated server-side key for admin-only 2K/4K calls.
HIGH_RES_IMAGE_API_KEY=
OPENAI_COMPAT_API_KEY=replace-me-openai-compat
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-secret
PROVIDER_NETWORK=chatgpt2api_default

# --- Public compose URLs ---
FRONTEND_PORT=5173
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5173

# --- Optional image/provider defaults ---
IMAGE_MODEL=gpt-image-2
# Optional: model override for 2K/4K calls, e.g. codex-gpt-image-2.
HIGH_RES_IMAGE_MODEL=
IMAGE_API_TIMEOUT_MS=120000
# Shared by backend validation and the frontend nginx proxy. Nginx adds 1 MiB
# multipart framing overhead at container startup.
UPLOAD_MAX_BYTES=10485760
DAILY_USER_QUOTA=20
LOG_LEVEL=info
DEMO_PROMPTS=
DEMO_PROMPT_CACHE_DELAY_MS=4000

# --- Optional local/demo admin seed ---
SEED_DEFAULT_ADMIN=false

# --- Optional Google OAuth ---
# If enabled, configure the Google redirect URI as:
# http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
