{
  "$schema": "./component-provenance.schema.json",
  "version": 1,
  "authoritativeSource": {
    "name": "beUI Pro",
    "catalog": "https://pro.beui.dev/components",
    "registry": "@beui-pro"
  },
  "registryFallbacks": [
    {
      "name": "shadcn/ui",
      "catalog": "https://ui.shadcn.com/docs/components",
      "registry": "shadcn"
    }
  ],
  "protectedRegistryFiles": [
    {
      "file": "src/components/ui/separator.tsx",
      "source": "shadcn Sidebar dependency",
      "sha256": "c58bb55104a53d838c9fd07e45003bd85c8052a9515eb339a390645fb723a697"
    },
    {
      "file": "src/components/ui/sheet.tsx",
      "source": "shadcn Sidebar dependency",
      "sha256": "478cd9250a66d4c55fbbe0503eaa2751a1beb9f7ba1a93e5174f8c2322c6eae1"
    },
    {
      "file": "src/components/ui/sidebar.tsx",
      "source": "shadcn Sidebar registry",
      "sha256": "e4ec68f5ffd8e18c0f272d477b8d7acf856a1c7e6c0521a7c9e3b4f398fcc8eb"
    },
    {
      "file": "src/components/ui/skeleton.tsx",
      "source": "shadcn Sidebar dependency",
      "sha256": "a65d56bf03874fd8d53b7f9f902d6f88dbed445828f064d0b121f62e7ad2bb5f"
    },
    {
      "file": "src/components/ui/tooltip.tsx",
      "source": "shadcn Sidebar dependency",
      "sha256": "7344991bfa353050715ced259b96d024400b252df04d49e6a3a67cde22ada172"
    }
  ],
  "nativeImplementationRoots": [
    {
      "root": "src/components/premium",
      "source": "beUI Pro copied-source components",
      "rationale": "Registry components own their native semantics and interaction internals."
    },
    {
      "root": "src/components/ui",
      "source": "shadcn registry primitives and Nebulens semantic adapters",
      "rationale": "Shared primitives are the only local boundary allowed to implement native controls; protected registry files must retain their recorded hashes."
    }
  ],
  "nativeControlExceptions": [
    {
      "file": "src/components/upload/ReferenceUploader.tsx",
      "tag": "input",
      "count": 1,
      "requiredAttributes": {
        "type": "file",
        "hidden": true
      },
      "rationale": "A hidden native file input is required to open the browser file picker; the visible trigger uses the shared Button primitive."
    }
  ],
  "foundationImports": [
    {
      "prefix": "@radix-ui/",
      "allowedRoots": ["src/components/premium", "src/components/ui"],
      "rationale": "Radix is an implementation foundation for shared beUI adapters, not a route-level component API."
    }
  ],
  "forbiddenComponentPackages": [
    "@chakra-ui/",
    "@headlessui/",
    "@mantine/",
    "@mui/",
    "antd",
    "element-plus",
    "primereact",
    "react-bootstrap",
    "semantic-ui-react"
  ],
  "externalVisualExceptions": [
    {
      "module": "@/components/BorderGlow",
      "file": "src/components/BorderGlow.tsx",
      "source": "ReactBits Border Glow",
      "allowedConsumers": ["src/components/premium/agent-chat-input/agent-chat-input.tsx"],
      "rationale": "Documented focus-only composer effect; it does not replace a semantic beUI control."
    },
    {
      "module": "@ybouane/liquidglass",
      "file": "src/components/landing/LiquidGlassSurface.tsx",
      "source": "https://github.com/ybouane/liquidglass",
      "allowedConsumers": ["src/components/landing/LiquidGlassSurface.tsx"],
      "rationale": "Composer-only WebGL material applied behind the existing beUI Agent Chat Input; it does not replace semantic controls."
    },
    {
      "module": "@/components/generation/ImageGenerationPlaceholder",
      "file": "src/components/generation/ImageGenerationPlaceholder.tsx",
      "source": "AICSS Image Generation",
      "allowedConsumers": ["src/views/GenerateView.tsx"],
      "rationale": "Documented generation-state visual adapted to the product's square, landscape, and portrait output geometry; it does not replace a semantic beUI control."
    }
  ]
}
